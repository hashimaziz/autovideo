{
  "name": "autovideo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "description": "Deterministic browser-to-video framework. Create polished product videos from code.",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "autovideo": "./dist/src/cli/bin.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:integration",
    "dev": "tsx src/cli/bin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
