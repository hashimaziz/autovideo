{
  "name": "autovideo",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "description": "Deterministic browser-to-video framework. Create polished product videos from code.",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "autovideo": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TERMS.md",
    "COMMERCIAL.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:integration",
    "dev": "tsx src/cli/bin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:all"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "video",
    "playwright",
    "browser",
    "screencast",
    "mp4",
    "ffmpeg",
    "product-video",
    "automation",
    "deterministic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOURNAME/autovideo.git"
  },
  "bugs": {
    "url": "https://github.com/YOURNAME/autovideo/issues"
  },
  "homepage": "https://github.com/YOURNAME/autovideo#readme"
}
