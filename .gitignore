# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Render output — generated artefacts, never source
output/
*.mp4
*.webm
!research/**/*.mp4

# Debug artefacts. Traces embed screencast frames of whatever was on screen and a full network
# log, so these are not just large — they are a record of whatever the app was displaying at the
# time, which for an authenticated session can be someone's personal data. They are the reason
# diagnostics are written to a per-run stamp directory rather than a fixed one.
/debug/

# Probe scratch: videos, extracted frames, Chromium profiles
**/.out/

# Credential-bearing browser state.
# A persistent profile holds live session cookies — never commit one.
.auth/
**/storage-state*.json

# Environment
.env
.env.local
.env.*.local

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*